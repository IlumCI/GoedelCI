[patch]
diff --git a/src/window.py b/src/window.py
index 52823cf..1238287 100644
--- a/src/window.py
+++ b/src/window.py
@@ -35,12 +35,46 @@ class Window:
     def full(self) -> bool:
         return len(self._values) == self.size
 
-    def mean(self) -> float:
+    def mean(self) -> float | None:
+        """Return the arithmetic mean of all values in the window.
+
+        Returns ``None`` when there are no values to summarise, otherwise
+        returns their average as a `float`.
+
+        Raises
+        ------
+        ValueError
+            When called on an empty window.
+        """
         if not self._values:
-            raise ValueError("an empty window has no mean")
+            return None
         return sum(self._values) / len(self._values)
 
     def peak(self) -> float:
         if not self._values:
             raise ValueError("an empty window has no peak")
         return max(self._values)
+
+
+class WindowStats(Window):
+    """A fixed-size stream of values with precomputed summaries.
+
+    Pushing a value updates all stats in O(1). Querying any stat is also
+    O(1), so this class supports high-throughput streaming pipelines where the
+    cost of updating and querying must remain low even under heavy load.
+    """
+
+    def __init__(self, size: int) -> None:
+        super().__init__(size)
+        self._sum = 0.0
+        self._peak = float("-inf")
+        self._min = float("inf")
+
+    @property
+    def sum(self) -> float:
+        return self._sum
+
+    def peak(self) -> float | None:
+        if not self._values:
+            return None
+        return max(self._values)
