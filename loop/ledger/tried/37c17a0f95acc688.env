-        raise AssertionError(f"{fn.__name__} answered for an empty window")
+def test_mean_empty() -> None:
+    """mean returns None when the window is empty.
+    
+    This is a precondition check, not an assertion on behavior — it simply
+    verifies that `Window` does not raise before we define what "None" means.
+    """
+    w = Window(5)
+    assert w.mean() is None
 
 
-def test_a_window_of_zero_is_refused_at_construction():
-    try:
-        Window(0)
-    except ValueError:
-        return
-    raise AssertionError("a window of no values was accepted")
+def test_mean_nonempty() -> None:
+    """mean returns the arithmetic mean of values in a non-empty window."""
+    w = Window(5).push(1).push(2).push(3)
+    assert w.mean() == 2.0
